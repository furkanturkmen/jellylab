{
  "expo": {
    "name": "JellyLab",
    "slug": "jellylab",
    "version": "0.11.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "jellylab",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#0FB6F2",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.furkanturkmen.jellylab",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "JellyLab uses the local network to discover Chromecast and other streaming receivers.",
        "NSPhotoLibraryUsageDescription": "JellyLab needs photo library access to update your profile picture.",
        "NSPhotoLibraryAddUsageDescription": "JellyLab needs permission to save photos to your library.",
        "NSCameraUsageDescription": "JellyLab needs camera access to take a new profile picture.",
        "NSMicrophoneUsageDescription": "JellyLab needs microphone access if you record a video with the camera.",
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "NSBonjourServices": [
          "_googlecast._tcp"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "buildNumber": "2"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D0D14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.furkanturkmen.jellylab",
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "JellyLab",
      "shortName": "JellyLab",
      "description": "iOS client for self-hosted Jellyfin + Jellyseerr",
      "themeColor": "#0D0D14",
      "backgroundColor": "#0D0D14",
      "display": "standalone",
      "lang": "en"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0D0D14"
        }
      ],
      "expo-secure-store",
      [
        "expo-video",
        {
          "supportsPictureInPicture": true,
          "supportsBackgroundPlayback": true
        }
      ],
      "expo-image",
      [
        "react-native-vlc-media-player",
        {
          "ios": {
            "includeVLCKit": true
          },
          "android": {
            "legacyJetifier": false
          }
        }
      ],
      [
        "react-native-google-cast",
        {
          "iosReceiverAppId": "CC1AD845",
          "iosDisableDiscoveryAutostart": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "JellyLab needs photo library access to update your profile picture.",
          "cameraPermission": "JellyLab needs camera access to take a new profile picture."
        }
      ],
      "expo-localization",
      "./plugins/withoutPushEntitlement"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "87dc2b63-b333-49f6-9785-cafbe516b90d"
      }
    },
    "owner": "thefurkan"
  }
}
